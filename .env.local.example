# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 인증 (Supabase Settings > API > JWT Secret 값과 동일하게 설정)
JWT_SECRET=your-supabase-jwt-secret

# 앱
NEXT_PUBLIC_APP_URL=https://roomly.vercel.app
NEXT_PUBLIC_CHECKIN_ALERT_MINUTES=120

# 브라우저 푸시 알림 (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_EMAIL=admin@roomly.app

# 크론 인증 (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 로 생성)
CRON_SECRET=your-cron-secret-here

# 이메일 (Resend — https://resend.com/api-keys 에서 발급)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Roomly <noreply@roomly.app>

# 토스페이먼츠 (https://developers.tosspayments.com 에서 발급)
TOSS_PAYMENTS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_WEBHOOK_SECRET=your-toss-webhook-secret

# 슈퍼어드민
SUPER_ADMIN_PASSWORD_HASH=your-sha256-hash
SUPER_ADMIN_EMAIL=superadmin@roomly.app

# AI 기능 (https://console.anthropic.com 에서 발급 — AI-01~AI-03 티켓에 필요)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
