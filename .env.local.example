# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 인증 (Supabase Settings > API > JWT Secret 값과 동일하게 설정)
JWT_SECRET=your-supabase-jwt-secret

# 앱
NEXT_PUBLIC_APP_URL=https://roomly.vercel.app
NEXT_PUBLIC_CHECKIN_ALERT_MINUTES=120

# Toss Payments (https://developers.tosspayments.com > API 키)
TOSS_PAYMENTS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# 크론 (Vercel Cron 인증)
CRON_SECRET=your-cron-secret

# 결제 실패 알림 수신용 운영자 이메일
SUPER_ADMIN_EMAIL=admin@roomly.app

# 브라우저 푸시 알림 (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:admin@roomly.app

# 이메일 (Resend — 없으면 발송 스킵)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Roomly <noreply@roomly.app>

# AI 인사이트/요약 (Anthropic — 없으면 AI 기능 비활성, AI-01/AI-03)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Rate Limiting (Upstash Redis — 없으면 인메모리 폴백, T-070)
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (T-170 — 없으면 비활성. 소스맵 업로드는 SENTRY_AUTH_TOKEN 필요)
SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=your-org
SENTRY_PROJECT=roomly
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx

# 네이티브 앱 FCM 푸시 (T-205 — 없으면 네이티브 푸시만 비활성, Web Push는 정상)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 JSON에서 추출
FIREBASE_PROJECT_ID=roomly-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@roomly-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"

# 노션 티켓 스크립트 (scripts/create_notion_tickets.mjs 실행 시에만 필요)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
